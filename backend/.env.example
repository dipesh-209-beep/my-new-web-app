# Backend configuration for running the API on the HOST (uvicorn, pytest).
#
# This file is separate from the root .env because it answers a different
# question. The root .env describes a deployment -- passwords, host
# identity, which ports to publish. This one describes a laptop: which
# Postgres to reach over loopback, and which origins the Next.js dev server
# is served from.
#
# In Docker, none of the values below are used: docker-compose.yml passes
# `env_file: backend/.env` but overrides DATABASE_URL, REDIS_URL and the
# OSRM URLs with container-network addresses, because "localhost" inside a
# container is the container. Compose's `environment:` block wins over
# `env_file:`, so the host values here are simply ignored there.
#
# Generated by `make env` from this template. Never commit the real
# backend/.env; it holds four secrets and must stay mode 0600.

# --- database --------------------------------------------------------------

# The one value here that must agree with the root .env: the password must
# equal that file's POSTGRES_PASSWORD, because the Docker Compose db
# service is initialised with it. These two files encode the same secret in
# different places, and they did in fact drift once, leaving host uvicorn
# and host pytest unable to authenticate while the stack itself worked
# fine from inside the network. `make env` now rewrites the password here to
# match, and `make backend-env-check` reports the drift, so if you set
# POSTGRES_PASSWORD by hand, run `make env` afterwards.
DATABASE_URL=postgresql://ktm_bus:change_me_to_the_root_postgres_password@localhost:5432/ktm_bus_route_finder

# --- browser access --------------------------------------------------------

# Comma-separated origins allowed to call the API (CORS).
#
# This is a development value. Production requires an https:// origin and
# refuses to start otherwise (see validate_production_settings in
# app/core/config.py), so a real deployment sets CORS_ORIGINS from the root
# .env's PUBLIC_CORS_ORIGINS via docker-compose.prod.yml rather than
# editing this line. Listing your LAN address alongside localhost is fine
# here and useful when testing the UI from a phone.
CORS_ORIGINS=http://localhost:3000,http://192.168.1.73:3000

# --- authentication --------------------------------------------------------

# Signing key for AdminUser login JWTs (POST /admin/login). Anyone holding
# it can mint a token for any admin account, so it is as sensitive as the
# admin passwords themselves. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_in_production

# Legacy shared secret for data-entry endpoints, used ONLY when
# ALLOW_LEGACY_SHARED_ADMIN_KEY=true.
#
# It is off by default and validate_production_settings() refuses to start
# a production process that enables it. It grants the full permission set
# to whoever holds it, cannot be scoped to one person, expires nothing,
# rotates only with a coordinated restart, and appears in audit records
# only as "a holder of the shared key". Prefer:
#
#   * a per-person AdminUser login -> JWT, for humans, or
#   * a scoped service credential   -> `SvcKey <id>.<secret>`, for scripts
#
# Both are attributable, revocable individually, and time-bounded. Leave
# this set to a real random value regardless: the startup check requires a
# non-placeholder one even while the legacy path is disabled, so a
# placeholder here would block a production deploy for no benefit.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me_in_production

# --- rate limiting and caching (optional) ----------------------------------

# Shared Redis for the response cache and the admin-login rate limiter.
#
# Declared here as a Settings field rather than read with os.getenv at each
# use site, because pydantic loads this file into the Settings object
# without putting it in os.environ -- an os.getenv("REDIS_URL") would
# never see a value set here.
#
# Leave unset for host development: the response cache falls back to a
# per-process dict and the rate limiter counts per worker, which is fine
# for one uvicorn process and unacceptable across several. Compose
# supplies this from the root .env's REDIS_PASSWORD instead, so you only
# need it if you want host runs to share a cache with the stack:
#   REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
#
# Note the credentials in a URL are the only thing `make test-backend` uses
# to reach the authenticated Redis, which is why that target exports it
# from the root .env rather than relying on this file.
# REDIS_URL=

# Optional: put rate-limit counters on a different Redis database (or
# server) from the response cache, so cache eviction does not reset login
# rate limits. Takes precedence over REDIS_URL.
# RATE_LIMIT_REDIS_URL=

# --- trusted hosts ---------------------------------------------------------

# Allowed Host headers, for Starlette's TrustedHostMiddleware. Empty by
# default, which disables the middleware -- correct for a laptop reached at
# localhost, wrong for a deployment, where an empty list makes
# validate_production_settings() refuse to start. It is the mitigation for
# Host-header manipulation of request.url; do not ship it empty.
# docker-compose.prod.yml sets this from the root .env's PUBLIC_HOST.
# TRUSTED_HOSTS=localhost,127.0.0.1

# Whether X-Forwarded-For / X-Real-IP may be trusted for rate-limit keys.
#
# Only ever true when the sole path to the backend is through the reverse
# proxy, because otherwise any client can send the header itself and mint
# a fresh rate-limit bucket per request. docker-compose.prod.yml sets this
# and passes matching --proxy-headers --forwarded-allow-ips to uvicorn.
# For a laptop calling the API directly, leave it false: every request
# comes from 127.0.0.1 and the limiter correctly treats them all as one
# client, which is the truth.
# TRUST_PROXY_HEADERS=false

# Which of development / production / test this process is. Anything else
# is rejected at startup. Only "production" enables the startup refusals in
# app/core/config.py, so leaving it at development on a real deployment
# silently disables all of them. Use "test" for a throwaway instance.
# ENVIRONMENT=development

# --- OSRM (optional) -------------------------------------------------------

# OSRM server for road-network geometry on map polylines.
# Optional: if unreachable, /route-finder still returns correct routes,
# just without road_geometry (falls back to null; frontend should draw
# straight-line segments between stops in that case).
OSRM_BASE_URL=http://localhost:5000

# Separate OSRM instance for pedestrian directions (GET /walking-route,
# used for "walk to nearest stop"). A single osrm-routed process only
# serves the profile baked into its .osrm file, so this needs its own
# foot.lua extract and its own port -- see backend/README.md.
# Optional: if unreachable, /walking-route returns 502 and the frontend
# falls back to drawing a straight dashed line instead.
OSRM_FOOT_BASE_URL=http://localhost:5001
