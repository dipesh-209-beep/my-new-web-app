# Deployment-level configuration, read by docker-compose.yml.
#
# Do NOT put this in version control with real values -- copy to `.env`
# (`make backend-env` does it for you and generates the secrets).
# Everything here is safe to commit; the generated `.env` is not.

# --- required, no defaults -------------------------------------------------
# Compose refuses to start without these, rather than falling back to a
# password that is published in this repository's history.

# PostgreSQL password for the `ktm_bus` role.
# Must be URL-safe: this value is interpolated straight into
# DATABASE_URL, so `@ : / ? # %` would corrupt the connection string.
# `make backend-env` generates it with secrets.token_urlsafe, which is safe.
POSTGRES_PASSWORD=change_me

# Redis password (redis is started with --requirepass).
# Same URL-safety constraint: it lands in REDIS_URL.
REDIS_PASSWORD=change_me

# --- deployment shape ------------------------------------------------------

# Exactly one of: "development" | "production" | "test".
# There is no "staging" -- the backend rejects any other value at startup
# rather than defaulting, so a typo fails loudly instead of coming up with
# every production check switched off.
#
# Only "production" enables validate_production_settings()
# (backend/app/core/config.py), which refuses to start on a weak JWT
# secret, the legacy shared admin key, wildcard or plain-http CORS, missing
# TRUSTED_HOSTS, or no shared rate-limit store. Setting this to "production"
# is the whole point of a production deployment -- leaving it at
# "development" turns every one of those refusals off.
#
# docker-compose.prod.yml sets this to production itself, so the prod path
# does not depend on remembering to set it here.
ENVIRONMENT=development

# --- production host identity (required by docker-compose.prod.yml) -------
#
# These two are unset here on purpose. Development does not need them: the
# backend takes its CORS and trusted-host values from backend/.env, which
# is already set to localhost origins for the Next.js dev server.
#
# docker-compose.prod.yml interpolates them with `:?`, so `make up-prod`
# fails immediately with a named error rather than starting a backend that
# then refuses to boot. Set them to your real values before deploying --
#
#   PUBLIC_HOST=ktm-bus.example.com
#   PUBLIC_CORS_ORIGINS=https://ktm-bus.example.com
#
# Both requirements come from validate_production_settings():
#   * TRUSTED_HOSTS must be non-empty. TrustedHostMiddleware is the
#     mitigation for Host-header request.url handling; an empty list
#     disables it.
#   * CORS_ORIGINS may not be "*", and may not consist only of http://,
#     localhost, or private-network origins -- a production frontend
#     origin has to be https://. Note the dev value
#     "http://localhost:3000,http://192.168.1.73:3000" in backend/.env is
#     exactly the shape production refuses.
#
# The frontend origin and the API host are usually the same hostname, but
# they do not have to be: if the Next.js app is served from a different
# origin than the API, list that origin in PUBLIC_CORS_ORIGINS.
PUBLIC_HOST=change_me_to_your_hostname
PUBLIC_CORS_ORIGINS=https://change_me_to_your_hostname

# Host port for the nginx ingress. 80 for a plain-HTTP staging box, 443 in
# production (docker-compose.prod.yml publishes 443 itself).
HTTP_PORT=80

# Whether the backend may trust X-Forwarded-For / X-Real-IP. Only ever
# "true" when the sole path to the backend is through `proxy` -- otherwise
# any client can forge the header and mint itself a fresh rate-limit bucket
# per request. docker-compose.prod.yml sets this to true, which is correct
# there because the base compose file publishes no backend port.
TRUST_PROXY_HEADERS=false
